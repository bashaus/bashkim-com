    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@parcel/watcher": "^2.6.0",
    "@prismicio/client": "^7.23.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
